{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            ta.token_id,\n            ta.merkle_root,\n            ta.merkle_proofs,\n            ta.community_id,\n            ta.community_name,\n            ta.total_amount,\n            ta.transaction_hash,\n            ar.claimed\n        FROM token_airdrops ta\n        JOIN airdrop_recipients ar ON ta.id = ar.token_airdrop_id\n        WHERE ar.account_id = $1 AND ta.token_id = $2\n        LIMIT 1\n        ",
